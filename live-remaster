#!/bin/bash

# Arch Live Remaster
# Adapted from antiX live-remaster for Arch Linux

# Default compression
COMP_TYPE="zstd"

# Safety margin
SAFETY_MARGIN=20

# Default settings
BACKUP_ORIG=
SKIP_MD5=false

# Check for root privileges and self-elevate if needed
if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

# Trap for cleanup
cleanup() {
    if [ "$BOOT_MP" != "/run/archiso/bootmnt" ]; then
        # Safety check: Prevent deletion of critical system paths
        case "$BOOT_MP" in
            "/"|"/home"|"/usr"|"/var"|"/etc"|"/boot"|"/root"|"/mnt"|"/media"|"/sys"|"/proc"|"/dev")
                echo "ERROR: Refusing to delete critical system path: $BOOT_MP"
                return 1
                ;;
        esac
        if umount "$BOOT_MP" 2>/dev/null; then
            rm -rf "$BOOT_MP"
        else
            echo "Failed to umount $BOOT_MP, skipping rm"
        fi
    fi
    rm -rf "/tmp/remaster.exclude"
}
trap cleanup EXIT

# Function to get size in MiB
fmt_size() {
    local size=$1
    echo "$size MiB"
}

# Function to get free space in MiB
free_space() {
    df -BM "$1" | awk 'NR==2 {print $4}' | sed 's/M$//' | awk '{print int($1)}'
}

# Function to get total space in MiB
all_space() {
    df -BM "$1" | awk 'NR==2 {print $2}' | sed 's/M$//' | awk '{print int($1)}'
}

# Function to get du size in MiB
du_size() {
    du -sm "$1" 2>/dev/null | awk '{print int($1)}' || echo 0
}

# Function to get compression type of squashfs
sqfs_comp_type() {
    local file=$1
    comp_num=$(dd if="$file" bs=1 skip=20 count=2 status=none 2>/dev/null | od -An -tdI)
    case $comp_num in
        1) echo gzip ;;
        2) echo lzma ;;
        3) echo lzo ;;
        4) echo xz ;;
        5) echo lz4 ;;
        6) echo zstd ;;
        *) echo unknown ;;
    esac
}

# Main function
main() {
    echo "Arch Live Remaster"

    # Set boot mount point
    BOOT_MP="/run/archiso/bootmnt"

    # Check if boot device is already mounted at the expected location
    if [ -f "$BOOT_MP/arch/x86_64/airootfs.sfs" ]; then
        SKIP_MOUNT=true
        ORIG_EXISTS=true
        echo "Found live file at $BOOT_MP/arch/x86_64/airootfs.sfs"
        # Ask about backup preference only if file exists and backup flag not set
        if [ -z "$BACKUP_ORIG" ]; then
            while true; do
                read -p "Backup original airootfs.sfs before replacing? (Y/n): " BACKUP_CHOICE
                case "$BACKUP_CHOICE" in
                    ""|y|Y)
                        BACKUP_ORIG=true
                        break
                        ;;
                    n|N)
                        BACKUP_ORIG=false
                        break
                        ;;
                    *)
                        echo "Please answer 'y' or 'n'"
                        ;;
                esac
            done
        fi
    else
        echo "Live file not found at $BOOT_MP/arch/x86_64/airootfs.sfs"
        SKIP_MOUNT=false
        ORIG_EXISTS=false
        BACKUP_ORIG=false

        if grep -q 'archisodevice=' /proc/cmdline; then
            BOOT_DEV=$(grep -o 'archisodevice=[^ ]*' /proc/cmdline | cut -d= -f2)
            echo "Found archisodevice from cmdline: $BOOT_DEV"
        else
            echo "No boot device found from /proc/cmdline"
            echo "Mount your boot device to $BOOT_MP and run again, or set archisodevice= in kernel cmdline"
            exit 1
        fi
    fi

    # Handle mounting
    if [ "$SKIP_MOUNT" != true ]; then
        if [ -n "$BOOT_DEV" ]; then
            # Create mount point directory
            mkdir -p "$BOOT_MP"
            echo "Attempting to mount $BOOT_DEV to $BOOT_MP"
            mount "$BOOT_DEV" "$BOOT_MP" || { echo "Cannot mount boot device $BOOT_DEV"; exit 1; }
            echo "Mounted boot device at $BOOT_MP"
        fi
    else
        # Already mounted, try to remount RW
        if mount -o remount,rw "$BOOT_MP" 2>/dev/null; then
            RW_SUCCESS=true
            echo "Remounted $BOOT_MP RW"
        else
            RW_SUCCESS=false
            echo "RW remount failed for $BOOT_MP"
        fi
    fi

    # Path to airootfs
    SQFILE_DIR="$BOOT_MP/arch/x86_64"
    SQFILE_FULL="$SQFILE_DIR/airootfs.sfs"
    OUTPUT_DIR="$SQFILE_DIR"

    # Ensure output directory exists
    mkdir -p "$SQFILE_DIR"

    # Check if device is writable
    if [ "$SKIP_MOUNT" != true ]; then
        # We just mounted it, so it should be writable
        RW_SUCCESS=true
        if ! touch "$BOOT_MP/test" 2>/dev/null || ! rm "$BOOT_MP/test" 2>/dev/null; then
            echo "ERROR: Boot device is not writable"
            exit 1
        fi
    elif [ "$RW_SUCCESS" = false ]; then
        # Already mounted, try to remount RW if needed
        if mount -o remount,rw "$BOOT_MP" 2>/dev/null; then
            RW_SUCCESS=true
            echo "Remounted $BOOT_MP RW"
        else
            echo "ERROR: Boot device is read-only and cannot be remounted"
            echo "Please remount the device as read-write and run again"
            exit 1
        fi
    fi

    # Get sizes - calculate uncompressed size only for included directories
    # Excluding: proc sys dev tmp mnt media lost+found var/tmp var/log var/cache var/lib/pacman/sync
    # Also exclude mounted filesystems that shouldn't be part of rootfs
    excludes_calc="proc sys dev tmp mnt media lost+found var/tmp var/log var/cache var/lib/pacman/sync"
    fs_new_size=0
    for dir in /*; do
        dir_name="${dir#/}"
        # Skip excluded directories
        skip=false
        for excl in $excludes_calc; do
            if [ "$dir_name" = "$excl" ]; then
                skip=true
                break
            fi
        done
        if [ "$skip" = false ] && [ -d "/$dir_name" ]; then
            # Special handling for /run - include archiso but exclude mounted bootmnt
            if [ "$dir_name" = "run" ]; then
                # Only count size of run/archiso, not the mount point
                run_archiso_size=$(du_size "/run/archiso" 2>/dev/null || echo 0)
                fs_new_size=$((fs_new_size + run_archiso_size))
            else
                dir_size=$(du_size "/$dir_name")
                fs_new_size=$((fs_new_size + dir_size))
            fi
        fi
    done

    if [ "$ORIG_EXISTS" = true ]; then
        sq_old_size=$(du_size "$SQFILE_FULL")
        echo "Original airootfs size: $(fmt_size $sq_old_size)"
    else
        sq_old_size=0
        echo "No original airootfs to compare"
    fi
    echo "Estimated new size (uncompressed): $(fmt_size $fs_new_size)"

    boot_total=$(all_space "$BOOT_MP")
    boot_avail=$(free_space "$BOOT_MP")

    echo "Boot device total: $(fmt_size $boot_total)"
    echo "Boot device free: $(fmt_size $boot_avail)"

    echo "Using compression: $COMP_TYPE"

    # Excludes: runtime mounts and cache
    excludes="proc sys dev tmp mnt media lost+found var/tmp var/log var/cache var/lib/pacman/sync"

    # Create exclude file
    exclude_file="/tmp/remaster.exclude"
    > "$exclude_file"
    for excl in $excludes; do
        echo "$excl" >> "$exclude_file"
    done
    # Handle /run specially - preserve archiso directory and exclude everything else in /run
    # Using negation pattern to ensure /run/archiso is included
    echo "!run/archiso" >> "$exclude_file"
    echo "!run/archiso/*" >> "$exclude_file"
    echo "run/*" >> "$exclude_file"

    mkdir -p "$OUTPUT_DIR"
    # Temp file
    tmp_file="$OUTPUT_DIR/airootfs.sfs.tmp"
    new_file="$OUTPUT_DIR/airootfs.sfs.new"

    # Ensure /run/archiso directory structure exists in the filesystem
    # These directories are needed as mount points during boot
    if [ ! -d "/run/archiso" ]; then
        mkdir -p /run/archiso
        echo "Created /run/archiso directory for mount point"
    fi
    if [ ! -d "/run/archiso/bootmnt" ]; then
        mkdir -p /run/archiso/bootmnt
        echo "Created /run/archiso/bootmnt directory"
    fi

    # Compression options
    OTHER_OPTS="-comp $COMP_TYPE"

    # Run mksquashfs
    echo "Creating new airootfs.sfs... This may take a while."
    if mksquashfs / "$tmp_file" $OTHER_OPTS -wildcards -ef "$exclude_file"; then
        echo "mksquashfs succeeded"
    else
        echo "mksquashfs failed"
        rm -f "$tmp_file"
        exit 1
    fi

    # Move to new
    echo "Moving to final file..."
    mv "$tmp_file" "$new_file"

    # Update md5
    if [ "$SKIP_MD5" = false ]; then
        echo "Calculating MD5 checksum..."
        md5sum "$new_file" > "$new_file.md5"
    fi

    sq_new_size=$(du_size "$new_file")
    echo "New airootfs created: $new_file ($(fmt_size $sq_new_size))"

    # Check space before replacing original
    boot_avail=$(free_space "$BOOT_MP")
    safe_space=$((sq_new_size + SAFETY_MARGIN))

    if [ $boot_avail -lt $safe_space ] && [ "$ORIG_EXISTS" = true ]; then
        echo "Not enough space to replace: $boot_avail MiB available, need $safe_space MiB"
        echo "You can manually replace later: mv $new_file $SQFILE_FULL && md5sum $SQFILE_FULL > $SQFILE_FULL.md5"
        exit 0
    fi

    # For live systems, handle replacement based on backup preference
    if [ "$SKIP_MOUNT" = true ]; then
        echo "Preparing to replace airootfs.sfs..."
        if mount -o remount,rw "$BOOT_MP" 2>/dev/null || [ "$BOOT_MP" = "/" ]; then
            if [ "$BACKUP_ORIG" = true ] && [ "$ORIG_EXISTS" = true ]; then
                echo "Backing up original airootfs.sfs..."
                mv "$SQFILE_FULL" "$SQFILE_FULL.old"
            elif [ "$ORIG_EXISTS" = true ]; then
                echo "Removing original airootfs.sfs..."
                rm "$SQFILE_FULL"
            fi
            echo "Replacing with new airootfs.sfs..."
            mv "$new_file" "$SQFILE_FULL"
            if [ "$SKIP_MD5" = false ]; then
                echo "Updating MD5..."
                md5sum "$SQFILE_FULL" > "$SQFILE_FULL.md5"
            fi
            if [ "$BOOT_MP" != "/" ]; then
                # Verify $BOOT_MP is not on the root filesystem to avoid locking up the system
                root_fs=$(df --output=source / | tail -n1)
                boot_fs=$(df --output=source "$BOOT_MP" 2>/dev/null | tail -n1)
                if [ "$root_fs" != "$boot_fs" ] || [ -z "$boot_fs" ]; then
                    echo "Remounting $BOOT_MP RO..."
                    mount -o remount,ro "$BOOT_MP"
                else
                    echo "WARNING: Skipping RO remount to avoid locking root filesystem"
                fi
            fi
            echo "Replacement complete. Reboot to test the new system."
        else
            echo "ERROR: Failed to remount $BOOT_MP RW for replacement"
            echo "Please manually replace: cp $new_file $SQFILE_FULL && md5sum $SQFILE_FULL > $SQFILE_FULL.md5"
            exit 1
        fi
    fi
}

# Parse options
while [ $# -gt 0 ]; do
    case $1 in
        -c|--comp)
            COMP_TYPE="$2"
            shift 2
            ;;
        --no-backup)
            BACKUP_ORIG=false
            shift
            ;;
        --no-md5sum)
            SKIP_MD5=true
            shift
            ;;
        -*)
            OPTS=${1#-}
            while [ -n "$OPTS" ]; do
                case "$OPTS" in
                    g*) COMP_TYPE=gzip ;;
                    l*) COMP_TYPE=lz4 ;;
                    x*) COMP_TYPE=xz ;;
                    z*) COMP_TYPE=zstd ;;
                    b*)
                        BACKUP_ORIG=false
                        ;;
                    m*)
                        SKIP_MD5=true
                        ;;
                    *)
                        echo "Usage: $0 [-c|--comp compression_type] [-g|l|x|z] [-b|--no-backup] [-m|--no-md5sum]"
                        echo "Supported compression: gzip(-g), lz4(-l), xz(-x), zstd(-z)"
                        exit 1
                        ;;
                esac
                OPTS=${OPTS#?}
            done
            shift
            ;;
        *)
            echo "Usage: $0 [-c|--comp compression_type] [-g|l|x|z] [-b|--no-backup] [-m|--no-md5sum]"
            echo "Supported compression: gzip(-g), lz4(-l), xz(-x), zstd(-z)"
            exit 1
            ;;
    esac
done

main
