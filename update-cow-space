#!/bin/bash

# Update CoW space in GRUB config for Arch live USB
# Usage: ./update-cow-space

# Version
VERSION="1.0"

set -euo pipefail

ME=${0##*/}

fatal() { echo "$ME: error: $*" >&2; exit 1; }

usage() {
    cat <<USAGE
Usage: $ME [options]

Update the CoW space parameter in GRUB config on the running Arch live USB.

This script detects if running from live USB and updates the appropriate GRUB config.
For copytoram mode, it will attempt to mount the boot partition automatically.

Options:
  -h, --help     Show this help message
  -v, --version  Show version information
USAGE
}

# Parse options
while [ $# -gt 0 ]; do
    case $1 in
        -h|--help) usage; exit 0 ;;
        -v|--version) echo "Update CoW Space v$VERSION"; exit 0 ;;
        *) usage; exit 1 ;;
    esac
done

# Allow help without root privileges
if [[ $# -gt 0 && ($1 == "-h" || $1 == "--help") ]]; then
    usage
    exit 0
fi

# Check for root privileges and self-elevate if needed
if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

# Check if running in live environment
[[ -d /run/archiso ]] || fatal "Not running in Arch live environment (/run/archiso not found)"

MOUNT_POINT=""
CREATED_MP=false

# Find the ESP partition (EFI System Partition) by label
ESP_LABEL="LIVE-UEFI"
ESP_PART=$(blkid -l -t LABEL="$ESP_LABEL" -o device 2>/dev/null)
if [ -z "$ESP_PART" ]; then
    # Fallback to common labels
    for label in ARCHISO_EFI MXarch-Live; do
        ESP_PART=$(blkid -l -t LABEL="$label" -o device 2>/dev/null)
        [ -n "$ESP_PART" ] && break
    done
fi
if [ -z "$ESP_PART" ]; then
    fatal "Could not find ESP partition with labels LIVE-UEFI, ARCHISO_EFI, or MXarch-Live"
fi

# Check if bootmnt is already mounted to the ESP
BOOTMNT_DEVICE=$(findmnt -n -o SOURCE /run/archiso/bootmnt 2>/dev/null)
if [ "$BOOTMNT_DEVICE" = "$ESP_PART" ] && [ -d /run/archiso/bootmnt ]; then
    # bootmnt is correctly mounted to ESP
    MOUNT_POINT="/run/archiso/bootmnt"
    echo "Using existing bootmnt at $MOUNT_POINT (mounted to ESP $ESP_PART)"
else
    # Need to mount ESP
    TMP_MOUNT="/tmp/archiso_esp"
    mkdir -p "$TMP_MOUNT"
    if mount "$ESP_PART" "$TMP_MOUNT" 2>/dev/null; then
        MOUNT_POINT="$TMP_MOUNT"
        CREATED_MP=true
        echo "Mounted ESP ($ESP_PART) at $MOUNT_POINT"
    else
        echo "Failed to mount ESP $ESP_PART"
        # Ask user to provide mount point
        read -p "Please mount the ESP ($ESP_PART) and provide the mount path: " USER_MP
        if [ -d "$USER_MP" ] && [ -d "$USER_MP/boot" ] && [ -f "$USER_MP/boot/grub/grub.cfg" ]; then
            MOUNT_POINT="$USER_MP"
            echo "Using user-provided mount point: $MOUNT_POINT"
        else
            fatal "Invalid mount point provided. Directory must contain boot/grub/grub.cfg"
        fi
    fi
fi

# Check if mount point exists and is accessible
[[ -d $MOUNT_POINT ]] || fatal "Mount point '$MOUNT_POINT' does not exist"
if ! mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
    fatal "$MOUNT_POINT is not a mounted filesystem"
fi

# Check for GRUB config
GRUB_CFG="$MOUNT_POINT/boot/grub/grub.cfg"
[[ -f $GRUB_CFG ]] || fatal "GRUB config not found at $GRUB_CFG"

# Get total memory in GB
TOTAL_MEM_GB=$(free -g | awk 'NR==2 {print $2}')
echo "Total system memory: ${TOTAL_MEM_GB}GB"

# Suggest CoW size based on memory
if [[ $TOTAL_MEM_GB -lt 4 ]]; then
    SUGGESTED="512M"
elif [[ $TOTAL_MEM_GB -lt 8 ]]; then
    SUGGESTED="1G"
else
    SUGGESTED="2G"
fi

echo "Suggested CoW space: $SUGGESTED (adjust based on your needs)"
read -p "Enter CoW space size (e.g., 1G, 512M): " COW_SIZE

# Validate input (basic check)
[[ $COW_SIZE =~ ^[0-9]+[MG]$ ]] || fatal "Invalid size format. Use e.g., 1G or 512M"

# Check if read-write
if ! touch "$MOUNT_POINT/.test_write" 2>/dev/null; then
    echo "Partition is read-only, attempting to remount as RW..."
    # Find the device
    DEVICE=$(findmnt -n -o SOURCE "$MOUNT_POINT" 2>/dev/null)
    [[ -n $DEVICE ]] || fatal "Could not determine device for $MOUNT_POINT"
    mount -o remount,rw "$DEVICE" "$MOUNT_POINT" || fatal "Failed to remount $DEVICE as RW"
    echo "Remounted as RW"
else
    rm -f "$MOUNT_POINT/.test_write"
fi

# Backup GRUB config
cp "$GRUB_CFG" "$GRUB_CFG.bak"
echo "Backed up GRUB config to $GRUB_CFG.bak"

# Update GRUB config: add cow_spacesize if not present
if grep -q "cow_spacesize" "$GRUB_CFG"; then
    echo "cow_spacesize already present, updating..."
    if ! sed -i "s/cow_spacesize=[^ ]*/cow_spacesize=$COW_SIZE/" "$GRUB_CFG"; then
        fatal "Failed to update cow_spacesize in GRUB config"
    fi
else
    echo "Adding cow_spacesize parameter..."
    if ! sed -i "/linux / s|$| cow_spacesize=$COW_SIZE|" "$GRUB_CFG"; then
        fatal "Failed to add cow_spacesize to GRUB config"
    fi
fi

# Verify the update
if ! grep -q "cow_spacesize=$COW_SIZE" "$GRUB_CFG"; then
    echo "Warning: cow_spacesize may not have been added correctly."
    echo "Current linux line(s):"
    grep "linux" "$GRUB_CFG" || echo "No linux line found"
    fatal "Verification failed: cow_spacesize not found in config"
fi

echo "Updated GRUB config with cow_spacesize=$COW_SIZE"
echo "Reboot the USB to apply changes."

# Cleanup if we mounted
if [ "$CREATED_MP" = true ]; then
    if umount "$MOUNT_POINT" 2>/dev/null; then
        rmdir "$MOUNT_POINT"
        echo "Unmounted and cleaned up temporary mount"
    else
        echo "Failed to unmount $MOUNT_POINT"
    fi
fi