# Version
VERSION="26.01"

set -uo pipefail

ME=${0##*/}

usage() {
    cat <<'USAGE'
Usage:
  ./iso-remaster --out <file.iso> [options]

Build an archiso-style ISO from an existing Arch root filesystem directory.
This is intended for snapshot/remaster workflows (host-side).

Required:
  --out <file.iso>     Output ISO path

Optional:
  --from <dir>         Root filesystem to snapshot (default: /)

Options:
  --arch <arch>        Default: x86_64
  --label <volid>      Volume label (auto-detect from <from>/boot/grub/grub.cfg)
                      Default fallback: MXarch-Live
  --grub-theme <path>  GRUB theme.txt path (auto-detect if omitted)
  --work <dir>         Work directory (default: mktemp)
  --comp <algo>        Squashfs compression (default: zstd)
  --kernel <path>      Default: <from>/boot/vmlinuz-linux
  --initrd <path>      Default: <from>/boot/archiso.img
   --no-copytoram       Do not include copytoram in grub cmdline
    -m|--no-md5sum       Skip MD5 checksum calculation (can be stacked)
    -q|--quiet           Suppress progress output (run quietly)
    -v|--version         Show version information

Examples:
  sudo iso-remaster --out ./archlive.iso --label ARCHLIVE
  sudo iso-remaster --from /mnt/arch-root --out ./custom.iso
USAGE
}

# Check for non-elevated options first
case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
    -v|--version)
        echo "iso-remaster v$VERSION"
        exit 0
        ;;
esac

# Ensure standard paths are in PATH for tools like xorriso
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:$PATH"

# Check for root privileges and self-elevate if needed
if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

fatal() { echo "$ME: error: $*" >&2; exit 2; }
need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        case $1 in
            mksquashfs) fatal "Missing $1 (install package: squashfs-tools)" ;;
            grub-mkrescue) fatal "Missing $1 (install package: grub)" ;;
            xorriso) fatal "Missing $1 (install package: xorriso or libisoburn)" ;;
            md5sum) fatal "Missing $1 (install package: coreutils)" ;;
            *) fatal "Missing required program: $1" ;;
        esac
    fi
}

FROM=
FROM_PROVIDED=false
OUT=
ARCH=x86_64
LABEL=
WORK=
COMP=zstd
KERNEL=
INITRD=
COPYTORAM=yes
SKIP_MD5=false
QUIET=false
GRUB_THEME=

while (( $# )); do
    case $1 in
        -h|--help) usage; exit 0 ;;
        -v|--version) echo "iso-remaster v$VERSION"; exit 0 ;;
        --from) FROM=${2:-}; FROM_PROVIDED=true; shift 2 ;;
        --out) OUT=${2:-}; shift 2 ;;
        --arch) ARCH=${2:-}; shift 2 ;;
        --label) LABEL=${2:-}; shift 2 ;;
        --work) WORK=${2:-}; shift 2 ;;
        --comp) COMP=${2:-}; shift 2 ;;
        --kernel) KERNEL=${2:-}; shift 2 ;;
        --initrd) INITRD=${2:-}; shift 2 ;;
        --no-copytoram) COPYTORAM=no; shift ;;
        --grub-theme) GRUB_THEME=${2:-}; shift 2 ;;
        --no-md5sum) SKIP_MD5=true; shift ;;
         --quiet) QUIET=true; shift ;;
        -*)
            OPTS=${1#-}
            while [[ -n $OPTS ]]; do
                case $OPTS in
                    m*) SKIP_MD5=true ;;
                    *) fatal "Unknown argument: -$OPTS" ;;
                esac
                OPTS=${OPTS#?}
            done
            shift
            ;;
        *) fatal "Unknown argument: $1" ;;
    esac
done

[[ -n $OUT ]] || { usage; exit 2; }

# Set default for FROM if not provided
if [[ $FROM_PROVIDED == false ]]; then
    FROM=/
    echo "$ME: warning: --from not set, defaulting to / (host root)" >&2
fi

# Validate and normalize paths
[[ $FROM == /* ]] || fatal "--from must be an absolute path: $FROM"
# Convert OUT to absolute path if relative
[[ $OUT == /* ]] || OUT="$(cd "$(dirname "$OUT")" 2>/dev/null && pwd)/$(basename "$OUT")" || fatal "Invalid output path: $OUT"

[[ -d $FROM ]] || fatal "--from is not a directory: $FROM"
[[ -r $FROM ]] || fatal "--from directory is not readable: $FROM"
[[ ! -f $OUT ]] || fatal "Output file already exists: $OUT"

# Validate output directory exists and is writable
OUT_DIR=$(dirname "$OUT")
[[ -d $OUT_DIR ]] || fatal "Output directory does not exist: $OUT_DIR"
[[ -w $OUT_DIR ]] || fatal "Output directory is not writable: $OUT_DIR"

# Validate architecture parameter
case $ARCH in
    x86_64|i686|aarch64) ;;
    *) fatal "Unsupported architecture: $ARCH (supported: x86_64, i686, aarch64)" ;;
esac

# Auto-detect label from existing GRUB config if not provided
if [[ -z $LABEL ]]; then
    GRUB_CFG_SRC=$FROM/boot/grub/grub.cfg
    if [[ -f $GRUB_CFG_SRC ]]; then
        LABEL=$(awk '
            /archisolabel=/{
                for (i=1;i<=NF;i++) if ($i ~ /^archisolabel=/) {
                    sub(/^archisolabel=/, "", $i);
                    print $i;
                    exit;
                }
            }
            /search .*--label/{
                for (i=1;i<=NF;i++) {
                    if ($i=="--label") {
                        gsub(/"/, "", $(i+1));
                        print $(i+1);
                        exit;
                    }
                    if ($i ~ /^--label=/) {
                        sub(/^--label=/, "", $i);
                        gsub(/"/, "", $i);
                        print $i;
                        exit;
                    }
                }
            }
        ' "$GRUB_CFG_SRC" | head -n1)
    fi
    if [[ -z $LABEL ]]; then
        LABEL=MXarch-Live
    fi
fi

# Validate ISO label (ISO9660 volume ID requirements)
if [[ ${#LABEL} -gt 32 ]]; then
    fatal "Label too long (max 32 chars): $LABEL"
fi
if [[ ! $LABEL =~ ^[A-Za-z0-9_-]+$ ]]; then
    fatal "Label contains invalid characters (use A-Z, a-z, 0-9, _, -): $LABEL"
fi

need mksquashfs
need grub-mkrescue
need xorriso
need md5sum

# Track whether work directory was user-provided
WORK_USER_PROVIDED=false
if [[ -n ${WORK} ]]; then
    WORK_USER_PROVIDED=true
else
    WORK=$(mktemp -d -t arch-remaster.XXXXXXXX)
fi
[[ -d $WORK ]] || fatal "Failed to create work directory: $WORK"

cleanup() {
    local exit_code=$?
    # Clean up work directory
    if [[ -n ${WORK:-} ]]; then
        if [[ $WORK_USER_PROVIDED == true ]]; then
            # Only clean up ISO subdirectory if work dir was user-provided
            [[ -d ${ISO_DIR:-} ]] && rm -rf "$ISO_DIR"
        else
            # Remove entire temp directory if we created it
            [[ -d ${WORK} ]] && rm -rf "$WORK"
        fi
    fi
    # Note: Keeping partial output file for debugging (do not remove on failure)
}
trap cleanup EXIT

ISO_DIR=$WORK/iso
ARCH_DIR=$ISO_DIR/arch
BOOT_DIR=$ARCH_DIR/boot/$ARCH
ROOTFS_DIR=$ARCH_DIR/$ARCH

mkdir -p "$BOOT_DIR" "$ROOTFS_DIR" "$ISO_DIR/boot/grub"

# Only check for /boot directory if using default kernel/initrd paths
if [[ -z $KERNEL || -z $INITRD ]]; then
    [[ -d $FROM/boot ]] || fatal "Missing /boot directory in rootfs: $FROM/boot"
fi

KERNEL=${KERNEL:-$FROM/boot/vmlinuz-linux}
INITRD=${INITRD:-$FROM/boot/archiso.img}

[[ -r $KERNEL ]] || fatal "Missing kernel: $KERNEL"
[[ -r $INITRD ]] || fatal "Missing archiso initramfs: $INITRD"

cp -a "$KERNEL" "$BOOT_DIR/vmlinuz-linux"
cp -a "$INITRD" "$BOOT_DIR/archiso.img"

SFS=$ROOTFS_DIR/airootfs.sfs
MD5=$ROOTFS_DIR/airootfs.md5

EXCLUDES=(
    proc sys dev run tmp
    mnt media
    var/tmp
    var/cache/pacman/pkg
    lost+found
)

EXTRA=()
case $COMP in
    # Block size 256KB (262144 bytes) for better compression ratio with xz/zstd
    xz) EXTRA=(-b 262144) ;;
    # For zstd, use 256KB blocks and compression level 15 (good balance of speed/ratio)
    zstd) EXTRA=(-b 262144 -Xcompression-level 15) ;;
    gzip|lz4|lzo) ;;  # No extra options
    *) fatal "Unsupported compression: $COMP (supported: gzip, lz4, lzo, xz, zstd)" ;;
esac

# Check disk space before creating squashfs
echo "$ME: checking disk space..."
AVAIL_MB=$(df -BM "$WORK" | awk 'END {gsub(/M/, "", $4); print $4+0}')
# Estimate source size (du follows symlinks by default, -s for summary)
# This is a rough estimate; squashfs will compress but we need working space
SOURCE_MB=$(du -sm "$FROM" 2>/dev/null | awk 'NR==1 {print $1+0}')

if [[ ! $AVAIL_MB =~ ^[0-9]+$ ]]; then
    AVAIL_MB=0
fi
if [[ ! $SOURCE_MB =~ ^[0-9]+$ ]]; then
    SOURCE_MB=0
fi

# Require at least source size + 500MB margin for temporary files and compression overhead
REQUIRED_MB=$((SOURCE_MB + 500))

if [[ $SOURCE_MB -eq 0 ]]; then
    echo "$ME: warning: could not estimate source size, skipping space check" >&2
elif [[ $AVAIL_MB -lt $REQUIRED_MB ]]; then
    fatal "Insufficient disk space: need ${REQUIRED_MB}MB, have ${AVAIL_MB}MB in $WORK"
fi

rm -f "$SFS"
args=(-comp "$COMP" "${EXTRA[@]}")
for excl in "${EXCLUDES[@]}"; do
    args+=(-e "$excl")
done
if [[ $QUIET == false ]]; then
    echo "$ME: building squashfs ($COMP) from $FROM -> $SFS"
    mksquashfs "$FROM" "$SFS" "${args[@]}"
else
    # Suppress progress output but preserve error messages (stderr)
    echo "$ME: building squashfs ($COMP) from $FROM -> $SFS (this may take several minutes)..."
    mksquashfs "$FROM" "$SFS" "${args[@]}" 1>/dev/null
    echo "$ME: squashfs creation complete"
fi

if [[ $SKIP_MD5 == false ]]; then
    (cd "$ROOTFS_DIR" && md5sum airootfs.sfs > "$MD5")
else
    rm -f "$MD5"  # Remove any existing MD5 file to avoid stale checksums
    [[ $QUIET == false ]] && echo "$ME: skipping MD5 checksum --no-md5sum"
fi

KPARAMS="archisobasedir=arch archisolabel=${LABEL}"
[[ $COPYTORAM == yes ]] && KPARAMS="$KPARAMS copytoram"

THEME_PATH=
THEME_REL=
if [[ -n ${GRUB_THEME:-} ]]; then
    if [[ -f $GRUB_THEME ]]; then
        THEME_PATH=$GRUB_THEME
    elif [[ -f $FROM/$GRUB_THEME ]]; then
        THEME_PATH=$FROM/$GRUB_THEME
    else
        fatal "--grub-theme not found: $GRUB_THEME"
    fi
else
    for candidate in \
        "$FROM/boot/grub/themes/mx/theme.txt" \
        "$FROM/usr/share/grub/themes/mx/theme.txt"
    do
        if [[ -f $candidate ]]; then
            THEME_PATH=$candidate
            break
        fi
    done
    if [[ -z ${THEME_PATH:-} ]]; then
        for dir in "$FROM/boot/grub/themes" "$FROM/usr/share/grub/themes"; do
            if [[ -d $dir ]]; then
                THEME_PATH=$(find "$dir" -maxdepth 2 -type f -name theme.txt 2>/dev/null | sort | head -n1)
                [[ -n $THEME_PATH ]] && break
            fi
        done
    fi
fi

if [[ -n ${THEME_PATH:-} ]]; then
    THEME_SRC_DIR=$(dirname "$THEME_PATH")
    THEME_NAME=$(basename "$THEME_SRC_DIR")
    mkdir -p "$ISO_DIR/boot/grub/themes"
    cp -a "$THEME_SRC_DIR" "$ISO_DIR/boot/grub/themes/"
    THEME_REL="/boot/grub/themes/$THEME_NAME/theme.txt"
    [[ $QUIET == false ]] && echo "$ME: using GRUB theme: $THEME_REL"
else
    [[ $QUIET == false ]] && echo "$ME: no GRUB theme found, using default menu"
fi

cat > "$ISO_DIR/boot/grub/grub.cfg" <<GRUBCFG
set default=0
set timeout=5
GRUBCFG

if [[ -n ${THEME_REL:-} ]]; then
    cat >> "$ISO_DIR/boot/grub/grub.cfg" <<GRUBCFG
if [ -f ${THEME_REL} ]; then
    loadfont /boot/grub/fonts/unicode.pf2
    insmod all_video
    insmod gfxterm
    terminal_output gfxterm
    set theme=${THEME_REL}
fi
GRUBCFG
fi

cat >> "$ISO_DIR/boot/grub/grub.cfg" <<GRUBCFG

menuentry "${LABEL} (${ARCH})" {
    search --no-floppy --set=root --label "${LABEL}"
    linux  /arch/boot/${ARCH}/vmlinuz-linux ${KPARAMS}
    initrd /arch/boot/${ARCH}/archiso.img
}
GRUBCFG

if [[ $QUIET == false ]]; then
    echo "$ME: creating ISO -> $OUT"
    if ! grub-mkrescue -o "$OUT" -volid "$LABEL" -l -R -J -pad -iso-level 3 "$ISO_DIR"; then
        fatal "ISO creation failed (check grub-mkrescue output and xorriso availability)"
    fi
else
    # Suppress progress output but preserve error messages (stderr)
    echo "$ME: creating ISO -> $OUT (this may take a few minutes)..."
    if ! grub-mkrescue -o "$OUT" -volid "$LABEL" -l -R -J -pad -iso-level 3 "$ISO_DIR" 1>/dev/null; then
        fatal "ISO creation failed (check grub-mkrescue output and xorriso availability)"
    fi
    echo "$ME: ISO creation complete"
fi

[[ -f $OUT ]] || fatal "ISO was not created: $OUT"
echo "$ME: done -> $OUT"
